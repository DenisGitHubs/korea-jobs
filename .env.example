# korea-jobs — backend (Vercel serverless) environment.
# NAMES ONLY. Real values live in Vercel project env vars (and a local .env for dev,
# git-ignored). Never commit values or print them in code/logs/chat (rule #1).
#
# This host (Vercel) is the ONLY place DATABASE_URL and the bot token live. The
# collector host must NOT receive these (007: secret isolation by host).

# Postgres — Neon, provisioned via Vercel Marketplace. The Vercel↔Neon integration
# injects these automatically into the project; listed here for local dev + docs.
DATABASE_URL=                   # pooled connection string — used by serverless functions
DATABASE_URL_UNPOOLED=          # direct (unpooled) string — used for migrations / DDL

# Telegram bot (@korea_rabota_bot). BOT_TOKEN is also the Mini App initData key.
BOT_TOKEN=
TG_WEBHOOK_SECRET=              # value sent back in X-Telegram-Bot-Api-Secret-Token
APP_URL=                        # deployed mini-app URL (for /start + notification buttons)

# Referral share link — canonical Mini App deep link t.me/<bot>/<app>?startapp=<code>.
# Optional: the same values can live in config (referral_bot_username/referral_app_shortname).
# Set these (or the config keys) or GET /api/referral falls back to a non-deep-link APP_URL.
REFERRAL_BOT_USERNAME=          # bot username WITHOUT '@' (e.g. korea_rabota_bot)
REFERRAL_APP_SHORTNAME=         # Mini App short-name from BotFather (e.g. app)

# Shared secrets between runtimes
INGEST_SECRET=                  # collector -> /api/ingest bearer; also set on the collector host
CRON_SECRET=                    # external scheduler -> /api/cron/* bearer

# AI parser
ANTHROPIC_API_KEY=              # Claude API; server-only; do not log prompts/answers with PII

# Local scheduled driver (db/parse-ticker.mjs) — only if the owner runs it instead of an
# external scheduler. Both must stay on the SAME 15-minute wall-clock boundary as the reader:
# a Neon compute sleeps only after 5 min of silence, so two schedules a few minutes apart keep
# it awake permanently (the Aug-2026 outage).
PARSE_TICK_MINUTES=15           # minutes between ticks, 1..60; default 15
CRON_PATH=/api/cron/tick        # the combined pass; set to /api/cron/parse for parsing only

# AppHub Studio hand-off — THE SECOND DOOR IN (POST /api/auth/hub).
# The shell hands a 60-second ticket signed by the hub's Ed25519 PRIVATE key; we only ever
# hold the PUBLIC half, and korea-jobs issues no tickets of its own.
# Three written forms are accepted, so paste whichever your host survives:
#   1. the PEM as-is, with real newlines (Vercel keeps them);
#   2. the PEM on ONE line with newlines written as the two characters \n (typical .env);
#   3. base64 of the whole PEM file.
# UNSET, or set to something that is not an Ed25519 public key -> /api/auth/hub answers
# 503 «not configured», never 401: that is our setup, not a forged ticket, and a 401 would
# send people to reinstall the app over our typo.
HUB_TICKET_PUBLIC_KEY=          # Ed25519 SPKI public key of the hub (apphub-hub)

# Several keys may be listed at once — that is how the hub's key pair is rotated with no
# downtime: put the NEW key beside the old one, then remove the old one later. Separate them
# with a comma, a semicolon, a blank line, or simply write one under the other (…END PUBLIC
# KEY-----, Enter, -----BEGIN PUBLIC KEY…). Entries are tried in order; one unusable line is
# skipped while a good key stands beside it.

# Tunables
INITDATA_TTL_SECONDS=900        # reject initData older than this (replay guard); 5–60 min
HUB_SESSION_TTL_SECONDS=86400   # life of OUR pass ('Authorization: kjs <token>'); 60..604800
#
# 🔴 THIS IS THE REVOCATION LEVER FOR THE SECOND DOOR (AppHub Studio), and it is the ONLY
# one that does not burn the bot. TO KILL EVERY PASS ALREADY ISSUED:
#   1. set HUB_SESSION_TTL_SECONDS=60 in the Vercel project settings;
#   2. press REDEPLOY (~1 minute) — without it NOTHING CHANGES. Vercel bakes environment
#      values into a PARTICULAR deployment: the one that is running keeps the values it was
#      built with, and the panel itself says the change applies "on your next deployment".
#      The server does re-read the variable on every request — but only requests served by
#      the NEW deployment see the new number.
# From the first request after the redeploy every pass minted for longer than 60 s is
# refused, and the shell simply opens korea-jobs again for an honest visitor (a fresh
# ticket, a fresh pass). The bot, door 1 (Telegram initData) and every Telegram session are
# NOT touched — that is the whole point of this lever.
#
# 0 IS NOT THE LEVER — WRITE 60. A value that is set but unusable (0, a negative number,
# text, or anything outside 60..604800) is REFUSED: the server uses 60 seconds and writes
# one line into the log naming this variable (never its value). So 0 does not mean "kill
# everything now" and it does not mean "a day" either — it means "this setting is broken,
# the floor is in force until you fix it". Say what you mean: 60.
# Leaving the variable UNSET (or empty) is the only silent case — that is the default day,
# 86400, and it is not an error.
ADMIN_TELEGRAM_IDS=             # comma-separated telegram_ids allowed into the admin panel
