# korea-jobs — collector (reader / userbot) environment.
# NAMES ONLY. Real values live in a local .env (git-ignored), or in the worker
# host's secret store. Never commit values (rule #1).
#
# IMPORTANT (007): this host holds ONLY the reader account session + the ingest
# secret. It must NOT hold the Supabase service-role key or the bot token — if
# this cheap third-party host is compromised, the blast radius stays limited to
# "spam into raw_messages" (filtered by AI + dedup), not the whole database.

# Telegram MTProto app credentials (from https://my.telegram.org, owner-created)
TG_API_ID=
TG_API_HASH=

# Reader account session string. Produced ONCE by `npm run login` (owner types the
# SMS code). Equivalent to the account password — treat as top secret.
TG_SESSION=

# Origin of the deployed backend, e.g. https://<host> (NO path).
# The collector appends the fixed paths /api/ingest and /api/sources itself.
# Backward-compatible: a legacy value ending in /api (e.g. https://<host>/api) is
# normalized to the origin, so both forms work.
INGEST_URL=
INGEST_SECRET=                  # must match the backend's INGEST_SECRET

# Ops
LOG_LEVEL=info                  # never log message text or phone numbers in plaintext
