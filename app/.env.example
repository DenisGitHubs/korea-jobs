# korea-jobs — mini app (React + Vite) environment.
# NAMES ONLY. Vite exposes only VITE_*-prefixed vars to the browser, so NEVER put
# a secret here (no service-role key, no bot token). Real values in local .env.
#
# NOTE: `npm run dev` already runs on MOCK data via the committed .env.development
# (VITE_API_MODE=mock) — no backend needed to preview the UI in a plain browser.
# This file documents the vars for real/live builds.

# API base. Empty = same-origin (app and /api are one Vercel project).
VITE_API_BASE_URL=

# Dev helpers (browser, outside Telegram)
VITE_API_MODE=live              # 'mock' to run the UI without a backend
VITE_TEST_INITDATA=             # dev-only raw initData so the live API works in a plain browser
